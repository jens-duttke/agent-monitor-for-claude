#!/bin/sh
# Start Agent Monitor for Claude without activating the virtual environment
# first, and from any working directory.  See the Linux section of README.md for
# how to put it on your PATH.
#
# Two things this has to get right.  The symlink is resolved before the
# directory is taken, so a link on the PATH still finds the checkout rather than
# the directory it was linked into.  And the checkout replaces the working
# directory at the head of sys.path, without a "cd": "python -m" would search
# the working directory first, so a folder holding another copy of the package
# (a second checkout, a worktree) ran that copy, and changing the directory
# would be a side effect the application never asked for.
set -eu

here=$(dirname -- "$(readlink -f -- "$0")")

if [ ! -x "$here/.venv/bin/python" ]; then
    echo "No virtual environment in $here/.venv - see the Linux section of README.md." >&2
    exit 1
fi

exec "$here/.venv/bin/python" -c 'import runpy, sys; sys.path[0] = sys.argv.pop(1); runpy.run_module("agent_monitor_for_claude", run_name="__main__", alter_sys=True)' "$here" "$@"
